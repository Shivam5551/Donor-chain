generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Change this to your database provider
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(uuid())
  fullName String
  email    String  @unique
  password String
  state    String
  createdAt DateTime @default(now())
}

model Organization {
  id            String  @id @default(uuid())
  charityName   String
  email         String  @unique
  password      String
  state         String
  charityId     String  @unique
  charitySector String
  isVerified    Boolean @default(false)
  createdAt     DateTime @default(now())
}